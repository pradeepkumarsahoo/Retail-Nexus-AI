# Author: Pradeep Sahoo — Retail Nexus AI
# Backend
APP_ENV=development
APP_SECRET_KEY=change-me-32-chars-minimum-change-me
API_V1_PREFIX=/api/v1

# Database — defaults to SQLite file next to the repo if left unset
# DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/control_tower
DATABASE_URL=sqlite:///./control_tower.db

# Redis (optional, for caching + job coordination)
REDIS_URL=redis://redis:6379/0

# LLM provider — "mock" is deterministic, bedrock/openai require creds
LLM_PROVIDER=mock
LLM_MODEL=mock-small
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Auth
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

# Agent limits
AGENT_MAX_STEPS=12
AGENT_STEP_TIMEOUT_SECONDS=20
AGENT_MAX_RETRIES=2

# Observability
LOG_LEVEL=INFO
LOG_FORMAT=json
OTEL_SERVICE_NAME=control-tower-backend
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# Rate limits (requests per minute)
RATE_LIMIT_INGEST=30
RATE_LIMIT_INVESTIGATION=60
